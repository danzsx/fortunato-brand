# Public, absolute URL used by canonical URLs and sitemap (no trailing slash)
SITE_URL=https://example.com
# Server-side lead webhook. Both variables are required in production.
# BRIEFING_WEBHOOK_URL=https://provider.example/webhooks/briefing
# BRIEFING_PROVIDER_API_KEY=
# Supabase is accessed only on the server. Never expose this key to the browser.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Private /admin access. Use a long, random value for ADMIN_SESSION_SECRET.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
